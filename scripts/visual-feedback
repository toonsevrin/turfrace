#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT_DIR"

OUTPUT_DIR=target/visual-feedback
mkdir -p "$OUTPUT_DIR"

run_scenario() {
    local scenario=$1
    shift
    local vulkan_icd=${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/lvp_icd.json}
    VK_ICD_FILENAMES="$vulkan_icd" \
        WGPU_BACKEND=${WGPU_BACKEND:-vulkan} \
        WGPU_SETTINGS_PRIO=${WGPU_SETTINGS_PRIO:-webgl2} \
        xvfb-run -a cargo run --quiet --example visual_playtest -- \
        --scenario "$scenario" \
        "$@"
    printf 'CAPTURED %s\n' "$scenario"
}

if [[ ${1-} == --all ]]; then
    shift
    for scenario in home leaderboard lobby lobby-empty lobby-robots countdown match capture respawn pause disconnect game-over results settings; do
        run_scenario "$scenario" "$@"
    done
    exit 0
fi

scenario=${1:-match}
if [[ $# -gt 0 ]]; then
    shift
fi
case "$scenario" in
    home|leaderboard|lobby|lobby-empty|lobby-robots|countdown|match|capture|respawn|pause|disconnect|game-over|results|settings) ;;
    *)
        printf 'usage: %s [--all|home|leaderboard|lobby|lobby-empty|lobby-robots|countdown|match|capture|respawn|pause|disconnect|game-over|results|settings] [--frames N | --seconds N] [--width PX] [--height PX]\n' "$0" >&2
        exit 2
        ;;
esac
run_scenario "$scenario" "$@"
