#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT_DIR"

# Always build the deployable artifact explicitly. A debug Trunk build can be
# an order of magnitude larger and is not a valid browser release candidate.
env -u NO_COLOR trunk build --release "$@"

wasm_files=(dist/*.wasm)
if [[ ${#wasm_files[@]} -ne 1 || ! -f ${wasm_files[0]} ]]; then
    printf 'expected exactly one release WASM file in dist/\n' >&2
    exit 1
fi

wasm=${wasm_files[0]}
raw_bytes=$(stat -c '%s' "$wasm")
if (( raw_bytes > 100000000 )); then
    printf 'release WASM is unexpectedly large: %s bytes\n' "$raw_bytes" >&2
    exit 1
fi

gzip -9 -c "$wasm" >"$wasm.gz"
printf 'WASM raw    %12d bytes\n' "$raw_bytes"
printf 'WASM gzip   %12d bytes\n' "$(stat -c '%s' "$wasm.gz")"
if command -v brotli >/dev/null 2>&1; then
    brotli --force --quality 11 "$wasm"
    printf 'WASM brotli %12d bytes\n' "$(stat -c '%s' "$wasm.br")"
else
    printf 'WASM brotli unavailable (install brotli for deployment compression)\n'
fi
