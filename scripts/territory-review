#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT_DIR"

OUTPUT=${1:-target/visual-feedback/territory-review.png}

mkdir -p "$(dirname -- "$OUTPUT")"
VK_ICD_FILENAMES=${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/lvp_icd.json} \
    WGPU_BACKEND=${WGPU_BACKEND:-vulkan} \
    WGPU_SETTINGS_PRIO=${WGPU_SETTINGS_PRIO:-webgl2} \
    xvfb-run -a cargo run --quiet --example territory_review -- \
    --output "$OUTPUT"

printf 'CAPTURED territory review: %s\n' "$OUTPUT"
